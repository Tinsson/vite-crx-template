{
  "name": "vite-crx-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @vite-crx/extension --filter @vite-crx/server dev",
    "dev:extension": "pnpm --filter @vite-crx/extension dev",
    "dev:server": "pnpm --filter @vite-crx/server dev",
    "build": "pnpm --filter @vite-crx/extension build",
    "clear": "pnpm --filter @vite-crx/extension clear",
    "lint": "eslint apps/extension/src packages",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build:cli": "pnpm --filter create-vite-crx build",
    "pack:cli": "pnpm --filter create-vite-crx pack",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:cli && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{js,ts,vue}": "eslint --quiet"
  }
}
